# Copy this file to .env and set one provider key.
# TypeSafe is preferred when both keys are configured.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Automatically approve only when every Jev risk probability is at or below
# this threshold. Set AUTO_ACCEPT to 0 to use only the generative reviewer.
HERDR_SWARM_JEV_AUTO_ACCEPT=1
HERDR_SWARM_JEV_ACCEPT_MAX=0.10
HERDR_SWARM_JEV_TIMEOUT=60

# Optional: pin a calibrated Jev version. Empty uses the provider default.
HERDR_SWARM_JEV_MODEL=

index 0000000..236b0ca
--- /dev/null
+++ b/src/usage/quota.ts
@@ -0,0 +1,48 @@
+import type { AccountUsage } from "../types/types.js";
+
+export type QuotaAvailability = {
+  status: "available" | "exhausted" | "unknown";
+  reason: string;
+  remainingFraction?: number;
+  resetTime?: string;
+};
+
+/** Check the exact runtime model and all reported limits in its shared pool. */
+export function assessModelQuota(usage: AccountUsage, runtimeModel: string): QuotaAvailability {
+  const model = usage.models.find((row) => row.modelId === runtimeModel);
+  if (!model) return { status: "unknown", reason: `Model ${runtimeModel} not reported` };
+
+  const pool = /^gemini-/i.test(runtimeModel)
+    ? /gemini/i
+    : /^(claude-|gpt-oss-)/i.test(runtimeModel)
+      ? /claude|gpt.?oss/i
+      : undefined;
+  const groups = pool ? usage.groups.filter((group) => pool.test(group.displayName)) : [];
+  const limits = [model, ...groups.flatMap((group) => group.buckets)];
+  const exhausted = limits.filter((limit) => limit.remainingFraction === 0);
+  if (exhausted.length) {
+    // Every exhausted window must reset before this account can become eligible.
+    const resets = exhausted.map((limit) => limit.resetTime).filter(
+      (value): value is string => !!value && Number.isFinite(Date.parse(value)),
+    );
+    const resetTime = resets.length === exhausted.length
+      ? resets.sort((a, b) => Date.parse(b) - Date.parse(a))[0]
+      : undefined;
+    return { status: "exhausted", reason: "Quota exhausted", remainingFraction: 0, resetTime };
+  }
+  if (usage.quotaSummaryError && !/SUBSCRIPTION_REQUIRED|#3501|(?:lack|missing).*license/i.test(usage.quotaSummaryError)) {
+    return { status: "unknown", reason: "Aggregate quota lookup unavailable" };
+  }
+  if (limits.some((limit) => typeof limit.remainingFraction !== "number" ||
+      !Number.isFinite(limit.remainingFraction) || limit.remainingFraction < 0 || limit.remainingFraction > 1)) {
+    return { status: "unknown", reason: "Missing or invalid quota remaining" };
+  }
+  if (groups.some((group) => !group.buckets.length)) {
+    return { status: "unknown", reason: "Quota pool has no limits" };
+  }
+  return {
+    status: "available",
+    reason: "Quota available",
+    remainingFraction: Math.min(...limits.map((limit) => limit.remainingFraction!)),
+  };
+}
